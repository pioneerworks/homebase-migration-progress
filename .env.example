# Keep this key in Vercel only. A read-only Linear personal API key is sufficient.
LINEAR_API_KEY=

# Browser authentication through the Homebase Okta organization.
OKTA_ISSUER=https://joinhomebase.okta.com/oauth2/default
OKTA_CLIENT_ID=
OKTA_CLIENT_SECRET=

# At least 32 random bytes used to sign the HttpOnly dashboard session.
AUTH_SECRET=

# Shared by Vercel and GitHub Actions. GitHub does not need the Linear key.
DASHBOARD_REFRESH_SECRET=

# Optional local-only Okta bypass. Ignored in production and on Vercel unless
# DASHBOARD_DISABLE_OKTA=1 is also set (temporary escape hatch — remove when
# the Okta sign-in redirect URI is whitelisted for the new domain).
DASHBOARD_DEV_USER=
DASHBOARD_DEV_NAME=
DASHBOARD_DISABLE_OKTA=

# GitHub API token (repo read scope) for live merged-PR history in the impact
# chart. Without it, the chart falls back to the committed seed snapshot.
GITHUB_TOKEN=

# Amplitude funnel source (preferred). Queries the Dashboard REST API funnels
# endpoint for the "Page Viewed (product_area mw_*, device != Linux) -> Owner
# Account Created" funnel as a daily series. Use the API key and secret key from
# Amplitude project settings (Cross-Platform project 677513).
# The same keys power the Experiments tab's live per-arm sign-up results.
# Leave unset to use the captured Amplitude snapshot (and Statsig's results).
AMPLITUDE_API_KEY=
AMPLITUDE_SECRET=
AMPLITUDE_SIGNUP_EVENT=Owner Account Created
AMPLITUDE_PAGEVIEW_EVENT=Page Viewed
AMPLITUDE_PRODUCT_AREA_PREFIX=mw_
AMPLITUDE_WINDOW_DAYS=30

# Omni analytics connection. When all OMNI_* vars are set, the impact chart
# uses live signup data; otherwise it uses the live Amplitude funnel or the
# captured snapshot.
OMNI_API_KEY=
OMNI_INSTANCE_URL=https://joinhomebase.omniapp.co
OMNI_MODEL_ID=
OMNI_SIGNUPS_TABLE=
OMNI_SIGNUPS_DATE_FIELD=
OMNI_SIGNUPS_COUNT_FIELD=
OMNI_SIGNUPS_RATE_FIELD=

# Statsig Console API key (read role) for the running-experiments section on
# the overview. Server-side only; leave unset to hide the section.
STATSIG_CONSOLE_API_KEY=

# Origin used by local development to relay Linear fetches through the
# deployed app (which holds the real LINEAR_API_KEY).
DASHBOARD_RELAY_ORIGIN=https://homebase-ai-project-tracker.vercel.app
